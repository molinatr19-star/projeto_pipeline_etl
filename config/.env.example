# Copiar para .env na raiz do projeto e preencher. Nunca versionar o .env.

# Ambiente: dev ou prod
AMBIENTE=dev

# Banco analítico local (relativo à raiz do projeto ou caminho absoluto).
# Se o projeto estiver numa pasta sincronizada (OneDrive, Dropbox), prefira um caminho fora
# dela, por exemplo: C:/Users/<usuario>/dados_pipeline_etl/pipeline.duckdb
# Evite AppData com o Python da Microsoft Store: ele redireciona gravações ali.
DUCKDB_CAMINHO=warehouse/pipeline.duckdb

# A API SGS do Banco Central não exige chave.
# Credenciais de outras fontes entram aqui quando forem adicionadas.
# API_CHAVE=
